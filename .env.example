# =============================================
# HireTalentIQ — Complete Environment Configuration
# =============================================

# ─────────────────────────────────────────────
# 1. PostgreSQL Database Configuration (Backend)
# ─────────────────────────────────────────────
# Option A: Direct full connection URI (Recommended for Cloud / Render / Supabase / Neon)
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/hiretalentiq

# Option B: Individual PostgreSQL parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hiretalentiq

# ─────────────────────────────────────────────
# 2. AI & Security Keys (Backend)
# ─────────────────────────────────────────────
# Google Gemini API key for AI JD Extraction & Candidate Parsing
GOOGLE_API_KEY=your_gemini_api_key_here

# JWT Secret for Multi-Tenant Auth Tokens (Change to a secure random string in production)
JWT_SECRET=hiretalentiq_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─────────────────────────────────────────────
# 3. Frontend Configuration (frontend/.env.local)
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001
